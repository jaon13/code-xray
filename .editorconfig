# CodeXray static analysis policy
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_namespace_match_folder = true:warning
dotnet_diagnostic.IDE0130.severity = warning

dotnet_diagnostic.RS0030.severity = warning
dotnet_diagnostic.RS0031.severity = warning

# code-consistency bans ConfigureAwait; disable rules that demand it
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.VSTHRD111.severity = none
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.RCS1090.severity = none

dotnet_diagnostic.MA0048.severity = none
dotnet_diagnostic.MA0006.severity = none
dotnet_diagnostic.MA0007.severity = none
dotnet_diagnostic.MA0003.severity = none
dotnet_diagnostic.S4200.severity = none
dotnet_diagnostic.S3220.severity = none
dotnet_diagnostic.S927.severity = suggestion
dotnet_diagnostic.S1135.severity = none

dotnet_diagnostic.CS4014.severity = warning
dotnet_diagnostic.VSTHRD001.severity = warning
dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD003.severity = warning
dotnet_diagnostic.VSTHRD100.severity = warning
dotnet_diagnostic.VSTHRD101.severity = warning
dotnet_diagnostic.VSTHRD103.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.VSTHRD200.severity = warning

dotnet_diagnostic.IDISP001.severity = warning
dotnet_diagnostic.IDISP002.severity = warning
dotnet_diagnostic.IDISP003.severity = warning
dotnet_diagnostic.IDISP004.severity = warning
dotnet_diagnostic.IDISP006.severity = warning
dotnet_diagnostic.IDISP008.severity = warning
dotnet_diagnostic.IDISP014.severity = warning
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA1816.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2200.severity = warning
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.MA0040.severity = warning

dotnet_diagnostic.S3776.severity = warning
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1506.severity = warning
dotnet_diagnostic.MA0051.severity = warning
dotnet_diagnostic.S108.severity = warning
dotnet_diagnostic.S2486.severity = warning
dotnet_diagnostic.S112.severity = warning
dotnet_diagnostic.S2259.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.RCS1077.severity = warning
dotnet_diagnostic.RCS1163.severity = suggestion
dotnet_diagnostic.RCS1213.severity = warning

dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1860.severity = warning
dotnet_diagnostic.CA1861.severity = warning
dotnet_diagnostic.CA1869.severity = warning
dotnet_diagnostic.SYSLIB1045.severity = warning
dotnet_diagnostic.SYSLIB1054.severity = warning
dotnet_diagnostic.CA1307.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.MA0002.severity = warning
dotnet_diagnostic.CA2100.severity = warning

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.VSTHRD200.severity = none
