<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Demo.Views.PanelAlpha">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Subtitle}" Opacity="0.7"/>
      <Button Content="{Binding RefreshLabel}" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Margin="0,0,0,8"/>
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                <TextBlock Grid.Column="1" Text="{Binding Code}" Margin="8,0,0,0"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
      <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" IsDefault="True"/>
    </StackPanel>
  </Grid>
</UserControl>
